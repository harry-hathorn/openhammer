{
	"name": "openhammer",
	"version": "1.1.1",
	"description": "Standalone MCP server (no LLM) exposing shell + filesystem tools to a remote agent over Streamable HTTP. Run it on a laptop or deploy it on a server to give any authenticated MCP client controlled computer access.",
	"type": "module",
	"main": "dist/main.js",
	"license": "MIT",
	"author": "Harry Hathorn (https://github.com/harry-hathorn)",
	"homepage": "https://openhammer.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/harry-hathorn/openhammer.git"
	},
	"bugs": {
		"url": "https://github.com/harry-hathorn/openhammer/issues"
	},
	"bin": {
		"openhammer": "dist/cli.js"
	},
	"engines": {
		"node": ">=20"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"mcp",
		"model-context-protocol",
		"claude",
		"claude-code",
		"cursor",
		"agent",
		"cli",
		"shell",
		"filesystem",
		"remote-control",
		"tunnel",
		"ai"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc && { chmod +x dist/cli.js 2>/dev/null || true; }",
		"prepublishOnly": "npm run build",
		"start": "node dist/main.js",
		"dev": "NODE_ENV=development tsx watch src/main.ts",
		"test": "vitest run --passWithNoTests",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
		"lint": "biome check src test",
		"format": "biome format --write src test",
		"test:compose": "docker compose up --build --exit-code-from test-runner --abort-on-container-exit",
		"test:compose:real": "docker compose --profile real up --build --exit-code-from real-test-runner --abort-on-container-exit real-test-runner",
		"test:in-container": "docker compose run --rm dev npm test",
		"test:tunnel": "bash scripts/test-tunnel.sh",
		"test:tunnel:ngrok": "bash scripts/test-tunnel-ngrok.sh"
	},
	"dependencies": {
		"@earendil-works/pi-tui": "^0.80.2",
		"@fastify/cors": "^8.5.0",
		"@fastify/formbody": "^7.4.0",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@ngrok/ngrok": "^1.7.0",
		"fastify": "^5.10.0",
		"jose": "^6.2.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@types/node": "^20.19.43",
		"pino-pretty": "^13.1.3",
		"tsx": "^4.22.4",
		"typescript": "^5.9.3",
		"vitest": "^4.1.9"
	}
}
